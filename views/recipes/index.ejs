<%- include('../partials/header') %>
<%- include('../partials/flash') %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1>All Recipes</h1>
    <p class="text-muted">Browse and manage your recipes.</p>
  </div>
  <a class="btn btn-success" href="/recipe/new">Add Recipe</a>
</div>
<div class="row">
  <% if (recipes.length === 0) { %>
    <div class="col-12">
      <div class="alert alert-info">No recipes yet. Create one to get started.</div>
    </div>
  <% } %>
  <% recipes.forEach(recipe => { %>
    <div class="col-md-6">
      <div class="card mb-4 shadow-sm">
        <div class="card-body">
          <h5 class="card-title"><%= recipe.dishName %></h5>
          <p class="card-text"><strong>Cooking time:</strong> <%= recipe.cookingTime %> mins</p>
          <p class="card-text"><strong>Difficulty:</strong> <%= recipe.difficulty %></p>
          <a href="/recipes/<%= recipe.id %>" class="btn btn-primary btn-sm">View</a>
          <a href="/recipes/<%= recipe.id %>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>
          <form action="/recipes/<%= recipe.id %>?_method=DELETE" method="POST" class="d-inline">
            <button class="btn btn-danger btn-sm" type="submit">Delete</button>
          </form>
        </div>
      </div>
    </div>
  <% }); %>
</div>
