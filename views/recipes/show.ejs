<%- include('../partials/header') %>
<%- include('../partials/flash') %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <h1><%= recipe.dishName %></h1>
        <p class="text-muted mb-2"><strong>Difficulty:</strong> <%= recipe.difficulty %></p>
        <p class="text-muted mb-2"><strong>Cooking time:</strong> <%= recipe.cookingTime %> minutes</p>
        <p><strong>Ingredients:</strong></p>
        <p><%= recipe.ingredients %></p>
        <p><strong>Instructions:</strong></p>
        <p><%= recipe.instructions %></p>
      </div>
    </div>
    <div class="d-flex gap-2">
      <a href="/recipes/<%= recipe.id %>/edit" class="btn btn-outline-secondary">Edit</a>
      <form action="/recipes/<%= recipe.id %>?_method=DELETE" method="POST">
        <button class="btn btn-danger">Delete</button>
      </form>
      <a href="/recipes" class="btn btn-link">Back to all recipes</a>
    </div>
  </div>
</div>
